# Copy to .env (gitignored) and fill in, then load it before running dbt:
#   set -a && source .env && set +a
#
# The -a wrapper matters: these are plain KEY=value lines with no `export`, so without it
# the values never reach dbt and every command fails with
#   Parsing Error: Env var required but not provided: 'DBT_ACCESS_TOKEN'

# Personal access token for dbt to reach the workspace. Local only — Databricks injects
# this itself for job dbt tasks, which is why dbt/profiles.yml can be committed.
DBT_ACCESS_TOKEN=
