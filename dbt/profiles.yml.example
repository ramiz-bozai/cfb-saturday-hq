# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR to this folder) and fill in
# host + http_path. A Databricks Job dbt task supplies these automatically, so this
# file is only needed when running dbt yourself.
cfb_saturday_hq:
  target: dev
  outputs:
    dev:
      type: databricks
      host: YOUR_WORKSPACE.cloud.databricks.com
      # SQL warehouse: /sql/1.0/warehouses/<warehouse_id>
      # All-purpose cluster: /sql/protocolv1/o/<org_id>/<cluster_id>
      http_path: /sql/1.0/warehouses/YOUR_WAREHOUSE_ID
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: cfb_saturday_hq
      # Per-folder schemas (cfb_bronze/cfb_silver/cfb_gold) override this;
      # it is only the fallback for models without a schema config.
      schema: cfb_silver
      threads: 4
